# Where "Play now" sends people. Defaults to the authenticated /home page.
VITE_PLAY_URL=/home
# Public source repository linked from the footer.
VITE_SOURCE_URL=https://github.com/Joohhnnyyy/Oru
# Canonical site origin used for Open Graph / JSON-LD (no trailing slash).
VITE_SITE_URL=https://oru.example.org

# Public AWS client settings. Run pnpm export-env after deploying the backend.
VITE_API_URL=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-south-1
# Optional demo account password; all VITE_* values are visible in the browser.
VITE_DEMO_PASSWORD=
