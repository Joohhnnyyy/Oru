{
  "name": "saafsafari-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && vitest run scripts/test/seed.test.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "cdk": "pnpm --filter @saafsafari/infra cdk",
    "bootstrap": "pnpm --filter @saafsafari/infra cdk bootstrap aws://517025126295/ap-south-1",
    "deploy:backend": "AWS_REGION=ap-south-1 AWS_DEFAULT_REGION=ap-south-1 CDK_DEFAULT_ACCOUNT=517025126295 CDK_DEFAULT_REGION=ap-south-1 pnpm --filter @saafsafari/infra cdk deploy --all --outputs-file ../cdk-outputs.json --require-approval never",
    "export-env": "tsx scripts/export-env.ts",
    "test:integration": "vitest run services/api/test/integration/live-e2e.test.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@types/node": "^22.13.0",
    "@saafsafari/game-rules": "workspace:*",
    "@saafsafari/shared": "workspace:*",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
